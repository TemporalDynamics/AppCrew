# ── API Keys (optional — system works in demo/offline mode without them) ──
# FIRECRAWL_API_KEY=
# BRAVE_SEARCH_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Email (Resend) ──
# RESEND_API_KEY=
# RECRUITER_EMAIL=

# ── WhatsApp ──
# WHATSAPP_BUSINESS_NUMBER=

# ── Calendly ──
# CALENDLY_LINK=

# ── Telegram (notificaciones recruiter + bot de candidatos) ──
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_BOT_USERNAME=   # username del bot sin @ (ej: TaloRecruitBot)

# ── Dashboard ──
# DASHBOARD_API_TOKEN=

# ── Logging ──
# LOG_LEVEL=info
